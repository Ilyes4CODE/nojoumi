# Dart / Flutter
.dart_tool/
.packages
build/
*.iml
.flutter-plugins
.flutter-plugins-dependencies
# Library packages do not commit a lock file; the Flutter app will (force-added
# when app/ is scaffolded, so its dependency set is reproducible for delivery).
packages/*/pubspec.lock

# Android
local.properties
.gradle/
captures/
*.apk
*.aab

# Signing material — NEVER commit. Art. 19 hands the keystore to the client
# directly, and a leaked key can never be rotated on Play.
*.jks
*.keystore
key.properties

# Secrets. Art. 7.7: API keys live on the server only, never in the app.
.env
.env.*
!.env.example
# The production template: every non-secret value filled in for the cPanel host,
# and the six that are secret left blank. Committing it saves fifteen lines of
# typing on the server without putting one credential in git history.
!.env.production.example
# Committed at the client's instruction (2026-08-31): it carries live
# credentials, and everyone with read access to this repository can use them.
!.env.production

# Python / Django
__pycache__/
*.py[cod]
.venv/
venv/
*.sqlite3
staticfiles/
mediafiles/

# Lesson images must never be committed — Art. 14 forbids storing them at all,
# and git history is permanent. This covers both the developer's own development
# photographs and the client's 10 acceptance images.
**/lesson_images/
**/captures/
tools/eval/samples/**
!tools/eval/samples/**/.gitkeep
!tools/eval/samples/README.md

# Eval harness output can quote lesson text, which is child data.
tools/eval/runs/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# A 55 MB tunnel binary for the Chargily webhook (Q19). Downloaded, not authored.
tools/bin/
.tmp/
