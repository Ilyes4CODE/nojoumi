# Production environment for bafisslunio.com.
#
# Committed at the client's instruction on 2026-08-31, the repository being
# private. **It carries live credentials**, so two things follow and neither is
# optional:
#
#   1. Anyone with read access to this repository can take payments on the
#      Chargily account, spend the AI budget, and forge a session on the live
#      site. That is the whole list of people who may have it.
#   2. Git history is permanent. Changing a key later does not remove the old
#      one from this file's history — it has to be regenerated at the provider.
#
# On the server:
#
#     cd ~/nojoumi/server
#     cp .env.production .env
#     nano .env          # one line: the database password
#
# It is a separate file from `.env` on purpose. `.env` cannot be tracked: the
# server needs production values and a development machine needs its own, and
# they are the same path — the first `git pull` on either side overwrites the
# other.


# Freshly generated for production — not the development key.
DJANGO_SECRET_KEY=VzC7bVCaNaklz_Zwv0_vXDiRJuG75SfZgQ47_01dxuW4_JQF841P37oCjUW4Qxw5FkA
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=bafisslunio.com,www.bafisslunio.com

# Percent-encoded: `]` is a reserved URL delimiter and `+` is read as a
# space by half the tooling in the world. The parser decodes both back, and
# a test asserts the round trip — an un-encoded character here makes MySQL
# report a wrong *host* rather than a wrong password, which sends whoever
# is debugging it to the wrong place entirely.
DATABASE_URL=mysql://zebqkuzf_ilyes:vpo1%5Dvc_QR%2ByXH.z@localhost:3306/zebqkuzf_db
LESSON_PROCESSOR=groq
GROQ_API_KEY=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
GROQ_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=AQ.Ab8RN6IuEjjsLCKnnBlOKzeXlKUwhrc5eKelF8TjKs4m2Zx6NQ
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_BUDGET=
GEMINI_BILLING_ENABLED=0
LESSON_IMAGE_MAX_BYTES=8388608
SUBSCRIPTION_SIGNING_KEY_HEX=5678a9a85ea128479957ac5c712e5511e7b6552b30e9dcd046cc35dec8251736

# Must stay empty: setting it overrides CHARGILY_LIVE_MODE entirely,
# so the flag can read 1 while every request goes to the sandbox.
CHARGILY_BASE_URL=
CHARGILY_PUBLIC_KEY=live_pk_qgWVR6Ze50PcEvzjaiLrMO7Xdzt4WCHfNUSlSR6n
CHARGILY_SECRET_KEY=live_sk_NOyLyn0z1iMxWFjuqFjowQ2B2nfjUqLxQL0NsZ9F
CHARGILY_LIVE_MODE=1
CHARGILY_SUCCESS_URL=
CHARGILY_FAILURE_URL=
CHARGILY_WEBHOOK_URL=https://bafisslunio.com/api/payments/webhook/chargily/

# --- Email: the password-reset code ------------------------------------------
# Create the mailbox in cPanel → Email Accounts, then fill the password in here.
# Port 465 is implicit TLS on every cPanel host; leave SSL=1 and TLS=0.
EMAIL_HOST=mail.bafisslunio.com
EMAIL_PORT=465
EMAIL_HOST_USER=no-reply@bafisslunio.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=Lunio <no-reply@bafisslunio.com>
