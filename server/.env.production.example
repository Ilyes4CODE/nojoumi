# Production environment for the cPanel host — bafisslunio.com
#
# Copy this to `.env` on the server and fill in the six values marked PASTE.
# Everything else is already correct for this deployment and should not need
# thinking about again:
#
#     cd ~/nojoumi/server
#     cp .env.production.example .env
#     nano .env          # six lines
#
# **The six are not here on purpose, and the repository being private is not the
# reason to change that.** This repository is handed to the client on delivery.
# The moment it is, a committed `.env` hands them the live Chargily secret (which
# creates payments and refunds on your account), the Groq key (whose cost Article
# 17 puts on *their* account, not yours), and `DJANGO_SECRET_KEY` (which forges
# any user's session). Git history is permanent: a key committed for one minute
# stays in every clone and every fork for ever.

# --------------------------------------------------------------------- Django
# PASTE — generate a fresh one, do not reuse the development key:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=bafisslunio.com,www.bafisslunio.com

# ------------------------------------------------------------------- database
# PASTE the password only. The database and user already exist in cPanel.
# If the password contains @ / : or ?, percent-encode it — @ becomes %40,
# / becomes %2F. The parser decodes it back; an un-encoded @ makes MySQL report
# a wrong host rather than a wrong password, which sends you looking in the
# wrong place.
#
# MySQL rather than PostgreSQL: the plan offers no PostgreSQL. That is an
# amendment to Article 3 and needs the client's written agreement — see
# decisions.md D-88.
DATABASE_URL=mysql://zebqkuzf_Ilyes:PASTE_PASSWORD@localhost:3306/zebqkuzf_db

# ------------------------------------------------------------------------- AI
LESSON_PROCESSOR=groq
GROQ_MODEL=qwen/qwen3.6-27b
# PASTE
GROQ_API_KEY=

# Article 3 names Claude for the acceptance run. Leave empty until it is needed.
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=

GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_BUDGET=
GEMINI_BILLING_ENABLED=0
GEMINI_API_KEY=

# 8 MB. Article 14's guard as much as a performance one: the upload handler is
# in-memory only, so an oversized image must be refused rather than spooled to
# disk where it would outlive the request.
LESSON_IMAGE_MAX_BYTES=8388608

# --------------------------------------------------------- snapshot signing
# PASTE the existing development key, **not a new one** — unless you are also
# rebuilding the app. Generating a fresh pair invalidates every subscription
# snapshot already on every phone, and the public half has to be passed to
# `flutter build` as LUNIO_SNAPSHOT_PUBLIC_KEY.
SUBSCRIPTION_SIGNING_KEY_HEX=

# -------------------------------------------------------------------- payments
# Must stay empty. Setting it overrides CHARGILY_LIVE_MODE completely, so the
# flag below can read 1 while every request still goes to the sandbox — a
# configuration that looks live and takes no money.
CHARGILY_BASE_URL=

CHARGILY_LIVE_MODE=1

# PASTE both. The public key is publishable by design and is the least sensitive
# of the six; the secret key is the one that must never leave this file.
CHARGILY_PUBLIC_KEY=
CHARGILY_SECRET_KEY=

# Derived from the request when empty, which is correct here: the parent arrives
# on whichever host they were sent to, and the return address follows them.
CHARGILY_SUCCESS_URL=
CHARGILY_FAILURE_URL=

# The address Chargily calls back on. **This is the whole reason live mode had to
# wait for a real host**: a tunnel that dies takes the confirmation with it, and
# a live payment whose confirmation never arrives cannot be recovered by the
# parent who made it.
CHARGILY_WEBHOOK_URL=https://bafisslunio.com/api/payments/webhook/chargily/
