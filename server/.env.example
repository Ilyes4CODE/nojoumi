# Lunio server configuration. Copy to .env and fill in.
# NOTHING in this file ever ships inside the Android app (Art. 7.7).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Art. 3). Dev falls back to SQLite when DATABASE_URL is unset.
DATABASE_URL=

# --- Lesson processing (Art. 3 + Art. 14) -------------------------------------
# Which adapter to use: groq | claude
# The contract names Claude API (Vision + Text). Groq is a development-only
# choice pending the client's written confirmation — see docs/decisions.md Q10.
LESSON_PROCESSOR=groq

# ⚠️ THIS FILE IS COMMITTED. Never put a real key here — put it in `.env`,
# which .gitignore blocks. Placeholders only.
GROQ_API_KEY=
GROQ_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Gemini. Requires a key from a project with BILLING ENABLED: Art. 14 forbids a
# provider that trains on inputs, and Google's free tier explicitly does.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_THINKING_BUDGET=0
GEMINI_BILLING_ENABLED=0

# Hard ceiling on an accepted lesson image, in bytes. Chosen so that Django's
# in-memory upload handler is always used and the image never reaches disk.
LESSON_IMAGE_MAX_BYTES=8388608

# --- Subscription snapshot signing (Art. 7.6) ---------------------------------
# Ed25519 private key, hex. The app embeds only the matching PUBLIC key.
SUBSCRIPTION_SIGNING_KEY_HEX=

# --- Chargily (Art. 7.2, 7.7) ------------------------------------------------
# Test-mode keys first. Client obligation, due before Phase 6 (Art. 7.8).
# Do not write integration code from remembered docs — see docs/CONVENTIONS.md.

# --- Chargily Pay v2 ---------------------------------------------------------
# Art. 7.7 — real values live in .env on the server and nowhere else. Never put
# a key here, never in a commit, never in a chat message.
# 0 = test endpoint (https://pay.chargily.net/test/api/v2)
# 1 = live endpoint (https://pay.chargily.net/api/v2)
CHARGILY_PUBLIC_KEY=
CHARGILY_SECRET_KEY=
CHARGILY_LIVE_MODE=0
CHARGILY_BASE_URL=
CHARGILY_TIMEOUT_SECONDS=20
CHARGILY_SUCCESS_URL=
CHARGILY_FAILURE_URL=
CHARGILY_WEBHOOK_URL=

# --- Email: the password-reset code, and nothing else -------------------------
# There is no newsletter, no receipt and no notification. Article 14 keeps the
# server's knowledge of a family down to an address and a subscription.
#
# Development ignores all of this and prints the message to the console.
# **Production refuses to start without it** — a reset that silently goes
# nowhere looks exactly like one that worked, and the parent is left refreshing
# an inbox.
#
# On cPanel: Email Accounts → create the mailbox → Connect Devices for the
# host name. Port 465 is implicit TLS (SSL=1, TLS=0); port 587 is STARTTLS
# (SSL=0, TLS=1). Exactly one of the two.
#
# DEFAULT_FROM_EMAIL must be a real mailbox on the site's own domain. SPF and
# DMARC are checked against *this* domain, and a mismatch is the single most
# common reason a code lands in spam.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=Lunio <no-reply@example.com>
