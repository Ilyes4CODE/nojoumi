<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only manifest. Merged into debug builds and nothing else.

    Its single job is to point at the network security config that allows plain
    HTTP to the development machine. Article 7.7 and the privacy obligations are
    unaffected: this changes what the *debug* build will connect to, never what
    is sent, and the release AAB never sees it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Restored after this file replaced Flutter's template version and took
         the template's INTERNET declaration with it. It is redundant now — the
         real declaration is in `src/main` where it belongs — but Flutter's own
         comment explains why the template puts it here, and deleting it a second
         time should be an obvious mistake rather than an invisible one:
         the Flutter tool needs it for hot reload and breakpoints. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
