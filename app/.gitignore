**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Machine-specific build defines: the LAN address of *this* developer's server.
# Not a secret - the snapshot key in it is the public half, and Article 7.7 keeps
# every real credential on the server. It is ignored because it is *wrong on
# every other machine*, and a committed one would silently point somebody else's
# build at an address that does not exist on their network.
lunio.local.json

# The production build defines are NOT ignored: the domain is public and the
# snapshot key is the public half by design. Committing them is what makes a
# release build one command instead of a remembered pair of --dart-defines.
!lunio.production.json
